# 서버 전용: Kakao Developers에서 발급한 REST API 키
KAKAO_REST_API_KEY=

# 서버 전용: SGIS 개발지원센터에서 발급한 서비스 ID / 보안 Key
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 서버 전용: 서울 열린데이터광장 인증키 (서울 생활인구)
SEOUL_OPEN_DATA_API_KEY=

# 선택사항: 서울시 서비스명이 변경될 때만 기본값(VwsmAdstrdNcmCnsmpW)을 재정의
SEOUL_CONSUMER_API_SERVICE=

# 서버 전용: 공공데이터포털 HIRA 병원정보서비스 승인키
HIRA_SERVICE_KEY=

# 선택사항: 공급자 변경 시에만 기본 HIRA 엔드포인트를 재정의
HIRA_HOSPITAL_API_URL=
HIRA_PHARMACY_API_URL=

# 서버 전용: 계약·승인된 상가 임대료 API
# URL 템플릿 자리표시자: {key} {lat} {lng} {radius} {admCode}
COMMERCIAL_RENT_API_KEY=
COMMERCIAL_RENT_API_URL_TEMPLATE=

# 서버 전용: 계약·승인된 국토·도시 개발계획 API
# URL 템플릿 자리표시자: {key} {lat} {lng} {radius} {admCode}
DEVELOPMENT_PLAN_API_KEY=
DEVELOPMENT_PLAN_API_URL_TEMPLATE=
VWORLD_API_KEY=

# 선택사항: 운영용 지도 타일 공급자 URL
NEXT_PUBLIC_MAP_TILE_URL=
