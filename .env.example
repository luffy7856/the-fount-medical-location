# 서버 전용: Kakao Developers에서 발급한 REST API 키
KAKAO_REST_API_KEY=

# 서버 전용: SGIS 개발지원센터에서 발급한 서비스 ID / 보안 Key
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# 서버 전용: 서울 열린데이터광장 인증키 (서울 생활인구)
SEOUL_OPEN_DATA_API_KEY=

# 선택사항: 서울시 서비스명이 변경될 때만 기본값(VwsmAdstrdNcmCnsmpW)을 재정의
SEOUL_CONSUMER_API_SERVICE=

# 서버 전용: 공공데이터포털 HIRA 병원정보서비스 승인키
HIRA_SERVICE_KEY=

# 선택사항: 공급자 변경 시에만 기본 HIRA 엔드포인트를 재정의
HIRA_HOSPITAL_API_URL=
HIRA_PHARMACY_API_URL=

# 선택사항: 한국부동산원 R-ONE 인증키. 미설정 시 특정 지역·분기 공표값을 공개 sample 모드로 조회합니다.
RONE_API_KEY=

# 서버 전용: 계약·승인된 상가 임대료 API
# URL 템플릿 자리표시자: {key} {lat} {lng} {radius} {admCode} {specialty}
#                              {minLng} {minLat} {maxLng} {maxLat} {bbox}
COMMERCIAL_RENT_API_KEY=
COMMERCIAL_RENT_API_URL_TEMPLATE=
# URL에 {key}를 넣지 않는 공급자만 실제 키 헤더 이름을 지정 (예: x-api-key)
COMMERCIAL_RENT_API_KEY_HEADER=
COMMERCIAL_RENT_SOURCE_NAME=
COMMERCIAL_RENT_SPATIAL_UNIT=
# manwon_per_pyeong | won_per_pyeong | won_per_square_meter | manwon_total_monthly | won_total_monthly
COMMERCIAL_RENT_VALUE_UNIT=manwon_per_pyeong
# manwon | won
COMMERCIAL_RENT_DEPOSIT_UNIT=manwon

# 서버 전용: 계약·승인된 국토·도시 개발계획 API
# VWorld 키를 쓸 때는 승인된 실제 계획 데이터셋 URL을 아래 템플릿에 설정
# 자리표시자: {key} {domain} {lat} {lng} {radius} {admCode}
#              {minLng} {minLat} {maxLng} {maxLat} {bbox}
DEVELOPMENT_PLAN_API_KEY=
DEVELOPMENT_PLAN_API_URL_TEMPLATE=
DEVELOPMENT_PLAN_API_KEY_HEADER=
DEVELOPMENT_PLAN_SOURCE_NAME=
VWORLD_API_KEY=
VWORLD_API_DOMAIN=https://the-fount-medical-location.vercel.app

# 선택사항: Vercel 배포에서는 OIDC로 AI Gateway를 사용합니다.
# 외부 호스팅/CI에서는 AI_GATEWAY_API_KEY를 설정하고, 모델은 필요할 때만 재정의합니다.
AI_GATEWAY_API_KEY=
AI_INSIGHT_MODEL=openai/gpt-5.4-mini

# 선택사항: 운영용 지도 타일 공급자 URL
NEXT_PUBLIC_MAP_TILE_URL=
